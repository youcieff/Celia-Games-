{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": true
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "publicProfiles": {
      "$uid": {
        ".read": false,
        ".write": false
      }
    },
    "matchHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "winStreaks": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "outgoingFriendRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "gameInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "outgoingGameInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('friends').child(auth.uid).child($uid).val() == true)",
        "connections": {
          "$connectionId": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
